# --- Access codes -----------------------------------------------------------
# Required. There are no defaults in the code — if these are unset, every code
# is refused. Pick your own; do not commit the real ones to this public repo.
#
# They MUST be different. The admin code is checked first, so setting both to
# the same value makes every single sign-up an admin — able to approve entries
# and manage accounts. The server logs a loud warning if you do.
ADMIN_CODE=
PUBLIC_CODE=

# --- Session signing --------------------------------------------------------
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (optional) ----------------------------------------------------
# Leave these blank to run on the local JSON store (.data/) with zero infra.
# Fill them in for the real multi-device deployment.
NEXT_PUBLIC_SUPABASE_URL=
# The SECRET key (Settings -> API Keys -> Secret keys), starting sb_secret_...
# On older projects this is the long service_role JWT. NOT the publishable/anon
# key — the app never uses that one, and RLS denies it everything.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dex-media

# --- Game rules -------------------------------------------------------------
# How many DIFFERENT admins must approve before an entry hits the public dex.
REQUIRED_APPROVALS=2

# --- Email alerts (optional) ------------------------------------------------
# Leave blank and the dex never sends mail — everything else works the same.
# The key comes from resend.com/api-keys. RESEND_FROM must be an address on a
# domain you have verified in Resend, or every send is rejected.
RESEND_API_KEY=
RESEND_FROM=Ashoka Pokedex <dex@primafacie.in>

# --- Public site URL --------------------------------------------------------
# Used for absolute share/preview URLs. Set to the real origin in production.
NEXT_PUBLIC_SITE_URL=https://primafacie.in
