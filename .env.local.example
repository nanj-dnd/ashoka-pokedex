# --- Session signing --------------------------------------------------------
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase ---------------------------------------------------------------
# Leave blank to run on the local JSON store (.data/) with zero infra.
# Required in production — the local store cannot run on a serverless host.
NEXT_PUBLIC_SUPABASE_URL=
# The SECRET key (Settings -> API Keys -> Secret keys), starting sb_secret_...
# NOT the publishable/anon key — RLS is deny-by-default and denies it everything.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dex-media

# --- Public site URL --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://primafacie.in

# --- Email alerts (optional) ------------------------------------------------
# With either unset, the app runs exactly as if alerts did not exist.
RESEND_API_KEY=
RESEND_FROM=

# NOTE: access codes and approval counts are NO LONGER environment variables.
# Every dex generates its own codes and sets its own rules — see /d/<slug>/settings.
